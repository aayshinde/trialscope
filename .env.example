# LLM parts (analyst agent, extraction, reason classification) are OPTIONAL. Without a key the dashboard answers the
# common questions with SQL.  Pick ONE of:
#   a) Free, local: install Ollama (https://ollama.com), run `ollama pull qwen2.5:7b-instruct`, then
# OPENAI_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=qwen2.5:7b-instruct
#   b) OpenAI:
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini
# "local" = TF-IDF + SVD text embeddings (free, offline). Or text-embedding-3-small (~$3-5 for all trials)
EMBED_MODEL=local

# Optional: higher rate limits for the enrichment step
NCBI_API_KEY=
OPENFDA_API_KEY=

# Out-of-time split (start years)
TRAIN_END_YEAR=2015
VAL_YEAR=2016
TEST_START_YEAR=2017
TEST_END_YEAR=2019
